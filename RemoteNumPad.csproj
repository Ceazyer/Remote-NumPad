<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <InformationalVersion>1.3.0</InformationalVersion>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
    <ApplicationIcon>assets\app-icon-light\remote-numpad-light.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Content Remove="android\**\*" />
    <None Remove="android\**\*" />
    <EmbeddedResource Remove="android\**\*" />
    <Content Remove="wwwroot\**\*" />
    <Content Remove="assets\**\*" />
    <None Remove="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteNumPad.Tests" />
    <InternalsVisibleTo Include="RemoteNumPad.AndroidProtocol.Tests" />
    <InternalsVisibleTo Include="RemoteNumPad.GuiSmoke" />
    <None Remove="NuGet.Config" />
    <Content Remove="NuGet.Config" />
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="RemoteNumPad.wwwroot.index.html" />
    <EmbeddedResource Include="wwwroot\style.css" LogicalName="RemoteNumPad.wwwroot.style.css" />
    <EmbeddedResource Include="wwwroot\app.js" LogicalName="RemoteNumPad.wwwroot.app.js" />
    <EmbeddedResource Include="assets\app-icon-light\remote-numpad-light.ico" LogicalName="RemoteNumPad.AppIcon" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>
</Project>
