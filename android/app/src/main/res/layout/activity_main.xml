<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" android:clipChildren="false" android:clipToPadding="false"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:id="@+id/top_chrome" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/chrome_header" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/status_panel" android:layout_width="match_parent"
            android:layout_height="60dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:id="@+id/status_identity" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
                <TextView android:id="@+id/brand_title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Remote NumPad"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="0.035"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/connection_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                    android:text="请设置电脑地址" android:textColor="@color/status_warn" android:textSize="12sp" />
                <TextView android:id="@+id/queue_count" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:importantForAccessibility="yes"
                    android:text="待发送 0 / 200" android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>
            <com.remotenumpad.ui.SoftKeyButton android:id="@+id/theme_button" android:layout_width="52dp"
                android:layout_height="52dp" android:contentDescription="切换到黑色主题" />
            <com.remotenumpad.ui.SoftKeyButton android:id="@+id/settings_button" android:layout_width="52dp"
                android:layout_height="52dp" android:contentDescription="电脑连接与诊断设置" />
        </LinearLayout>
        <LinearLayout android:id="@+id/page_tabs" android:layout_width="match_parent"
            android:layout_height="60dp" android:gravity="center" android:orientation="horizontal">
            <com.remotenumpad.ui.SoftKeyButton android:id="@+id/tab_keypad" android:layout_width="0dp"
                android:layout_height="52dp" android:layout_marginHorizontal="3dp"
                android:layout_weight="1" android:text="数字 · 导航" android:textSize="13sp" />
            <com.remotenumpad.ui.SoftKeyButton android:id="@+id/tab_editing" android:layout_width="0dp"
                android:layout_height="52dp" android:layout_marginHorizontal="3dp"
                android:layout_weight="1" android:text="公式 · 编辑" android:textSize="13sp" />
        </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/compact_status" android:layout_width="match_parent" android:layout_height="18dp"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:paddingStart="6dp"
            android:visibility="gone" android:importantForAccessibility="yes" />
        <TextView android:id="@+id/diagnostics_count" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingHorizontal="6dp" android:textColor="@color/text_secondary"
            android:textSize="11sp" android:visibility="gone" />
        <FrameLayout android:id="@+id/navigation_panel" android:layout_width="match_parent"
            android:layout_height="64dp" android:clipChildren="false" android:clipToPadding="false" />
    </LinearLayout>
    <FrameLayout android:id="@+id/command_panel" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipChildren="false"
        android:clipToPadding="false" android:paddingTop="4dp" />
</LinearLayout>
